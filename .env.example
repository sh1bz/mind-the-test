# Copy to .env and fill from your Supabase project (Settings → API). Leave empty to run local-only.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Google Ads conversion tracking (optional). Conversion ID and the three labels from Ads → Goals → Conversions.
PUBLIC_GADS_ID=
PUBLIC_GADS_UNLOCK=
PUBLIC_GADS_START=
PUBLIC_GADS_TEN=
PUBLIC_GADS_DATE=
