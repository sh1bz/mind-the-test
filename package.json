{
	"name": "until-it-sticks",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"content": "node scripts/build-content.mjs",
		"deploy": "vite build && npx wrangler pages deploy build --project-name untilitsticks --branch main --commit-dirty=true && npm run indexnow",
		"indexnow": "node scripts/indexnow.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"node-html-parser": "^9.0.1",
		"svelte": "^5.20.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"vite": "^6.2.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.48.0"
	}
}
